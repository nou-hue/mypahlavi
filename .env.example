# ── Shop: Stripe (card payments) ──────────────────────────────────────────
# Vercel → Project “mypahlavi” → Settings → Environment Variables → Production
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook endpoint (after deploy):
#   POST https://www.mypahlavi.com/api/shop/webhook
#   Events: checkout.session.completed

# ── Shop: Printify (live catalogue + fulfilment) ──────────────────────────
# Printify → Account → Connections → Personal access tokens → Generate
PRINTIFY_API_TOKEN=
# Shop number from Printify URL (.../store/12345678/...) OR:
#   curl -H "Authorization: Bearer TOKEN" https://api.printify.com/v1/shops.json
PRINTIFY_SHOP_ID=

# After setting both on Vercel: Deployments → Redeploy latest.
# Check: https://www.mypahlavi.com/api/shop/status
# Live products: https://www.mypahlavi.com/api/shop/catalog
# Editions page auto-loads products from your Printify shop when connected.

# ── Database (orders) ─────────────────────────────────────────────────────
# Neon → Create project → copy connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
