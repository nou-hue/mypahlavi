# ── Shop: Stripe (card payments) ──────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook endpoint (after deploy):
#   POST https://YOUR_DOMAIN/api/shop/webhook
#   Events: checkout.session.completed

# ── Shop: Printify (print-on-demand fulfilment) ───────────────────────────
# Printify → Account → Connections → API
PRINTIFY_API_TOKEN=
# From GET https://api.printify.com/v1/shops.json  (or Printify URL)
PRINTIFY_SHOP_ID=

# After products exist in Printify, set printifyProductId + variant printifyVariantId
# on items in src/data/shop.ts  — or call GET /api/shop/printify/products to inspect IDs.
